{
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.16",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/path": "jsr:@std/path@1.1.4",
    "fast-xml-parser": "npm:fast-xml-parser@5.10.1"
  },
  "fmt": {
    "exclude": ["examples/assets", "vendor"],
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "exclude": ["vendor"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "setup": "deno cache --frozen scripts tests",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "typecheck": "deno check --frozen scripts tests",
    "fetch": "deno run --allow-read --allow-write --allow-run=mise scripts/sync-sources.ts update",
    "generate:bindings": "deno run --allow-run=castxml,clang,doxygen,zig --allow-read --allow-write scripts/generate-bindings.ts",
    "generate:metadata": "deno run --allow-read=build.zig.zon,sdl_metadata.zig --allow-write=build.zig.zon,sdl_metadata.zig --allow-run=mise scripts/sync-package-metadata.ts write",
    "package:release": "deno run --allow-read --allow-write --allow-run=deno,mise,7zz,tar,sha256sum,zig scripts/package-release.ts",
    "docs": "zig build docs",
    "test:metadata": "deno run --allow-read=build.zig.zon,sdl_metadata.zig --allow-run=mise scripts/sync-package-metadata.ts check",
    "test:sources": "deno run --allow-read --allow-run=mise,diff,cmp scripts/sync-sources.ts check",
    "test:bindings": "deno test --frozen tests/codegen",
    "test:build": "deno test --frozen --allow-read --allow-write --allow-run=cmake,deno,mise,7zz,zig tests/package-release.test.ts tests/build/linux.test.ts tests/build/macos.test.ts",
    "test:windows-build": "deno test --frozen --allow-read --allow-write --allow-run=cmake,mise,7zz,zig,cmd tests/build/windows.test.ts",
    "generate": {
      "dependencies": ["generate:metadata", "generate:bindings"]
    },
    "check": {
      "dependencies": [
        "fmt:check",
        "lint",
        "typecheck",
        "test:metadata",
        "test:sources",
        "test:bindings",
        "test:build"
      ]
    },
    "release-check": {
      "dependencies": ["check", "docs"]
    }
  }
}
